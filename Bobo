Tabs.Guards:AddParagraph({ Title = "Guards", Content = "Client delete guards" })

Tabs.Guards:AddButton({
    Title       = "Delete All Guards",
    Description = "Clears guard cliently.",
    Callback    = function()
        local guards = workspace:FindFirstChild("Map")
            and workspace.Map:FindFirstChild("Zones")
            and workspace.Map.Zones:FindFirstChild("Field")
            and workspace.Map.Zones.Field:FindFirstChild("Guards")

        if not guards then
            Fluent:Notify({ Title = "Guards", Content = "Guards folder not found!", Duration = 3 })
            return
        end

        local count = 0
        for _, guard in ipairs(guards:GetChildren()) do
            if guard:IsA("Model") then
                for _, part in ipairs(guard:GetDescendants()) do
                    if part:IsA("VectorForce") or part:IsA("BodyVelocity")
                    or part:IsA("BodyForce") or part:IsA("BallSocketConstraint")
                    or part:IsA("HingeConstraint") or part:IsA("AnimationController") then
                        pcall(function() part:Destroy() end)
                    end
                end
                guard:Destroy()
                count += 1
            end
        end

        local char = LocalPlayer.Character
        if char then
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BallSocketConstraint") or obj:IsA("HingeConstraint")
                or obj:IsA("BodyVelocity") or obj:IsA("VectorForce")
                or obj:IsA("BodyForce") or obj:IsA("BodyAngularVelocity") then
                    pcall(function() obj:Destroy() end)
                end
            end
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.PlatformStand = false
            end
        end

        Fluent:Notify({ Title = "Guards", Content = "Deleted " .. count .. " guards and cleaned your ragdoll!", Duration = 4 })
    end,
})

