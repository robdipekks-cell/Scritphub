local FARM_RARITIES = {
    "Common","Uncommon","Rare","Epic","Legendary",
    "Mythic","God","Secret","Exclusive"
}

local autoFarm         = false
local selectedRarities = {}

Tabs.Farm:AddParagraph({ Title = "Farm", Content = "Select rarities then toggle to farm NPCs." })

Tabs.Farm:AddDropdown("FarmRarityDropdown", {
    Title       = "Rarity",
    Description = "Which rarities to target",
    Values      = FARM_RARITIES,
    Multi       = true,
    Default     = {},
    Callback    = function(vals)
        selectedRarities = {}
        for k, v in pairs(vals) do
            if v then table.insert(selectedRarities, k) end
        end
    end,
})

local function raritySelected(rarity)
    for _, r in ipairs(selectedRarities) do
        if r == rarity then return true end
    end
    return false
end

local function getRarityFromNPC(npc)
    -- Path: npc.OverheadAttachment.CharacterInfo.Frame.Rarity
    local overhead = npc:FindFirstChild("OverheadAttachment")
    if not overhead then return nil end
    local info = overhead:FindFirstChild("CharacterInfo")
    if not info then return nil end
    local frame = info:FindFirstChild("Frame")
    if not frame then return nil end
    local rarityLabel = frame:FindFirstChild("Rarity")
    if not rarityLabel then return nil end
    -- It's a text label — get the Text property
    return rarityLabel.Text
end

local function runAutoFarm()
    while autoFarm do
        if #selectedRarities == 0 then
            Fluent:Notify({ Title = "Farm", Content = "Select at least one rarity!", Duration = 3 })
            task.wait(2)
            continue
        end

        local npcFolder = workspace:FindFirstChild("Map")
            and workspace.Map:FindFirstChild("Zones")
            and workspace.Map.Zones:FindFirstChild("Field")
            and workspace.Map.Zones.Field:FindFirstChild("NPC")

        if not npcFolder then task.wait(1) continue end

        local farmedAny = false

        for _, npc in ipairs(npcFolder:GetChildren()) do
            if not autoFarm then break end
            if not npc:IsA("Model") then continue end

            local rarity = getRarityFromNPC(npc)
            if not rarity then continue end
            if not raritySelected(rarity) then continue end

            -- TP to NPC
            local cf = getCF(npc)
            if cf then tpTo(cf) task.wait(0.3) end

            -- Fire pickup prompt
            local prompt = npc:FindFirstChild("Prompts")
                and npc.Prompts:FindFirstChild("Pickup")
            if prompt then
                pcall(fireproximityprompt, prompt)
                task.wait(0.5)
            end

            farmedAny = true

            -- TP to player's plot
            local myPlot = getMyPlot()
            if myPlot then
                local plotCF = getCF(myPlot)
                if plotCF then tpTo(plotCF, 5) end
            end

            task.wait(0.5)
        end

        if not farmedAny then task.wait(1) end
    end
end

Tabs.Farm:AddToggle("ToggleAutoFarm", {
