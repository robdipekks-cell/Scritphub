})

local function refreshPlayers()
    playerList = {}
    local vals = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(playerList, p)
            table.insert(vals, p.Name .. " (" .. p.UserId .. ")")
        end
    end
    tradeDropdown:SetValues(vals)
    Fluent:Notify({ Title = "Trade", Content = "Player list refreshed!", Duration = 2 })
end

Tabs.Trade:AddButton({
    Title       = "Refresh Players",
    Description = "Update the player list",
    Callback    = function()
        refreshPlayers()
    end,
})

Tabs.Trade:AddToggle("ToggleAutoTrade", {
    Title       = "Auto Trade",
