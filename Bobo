-- ============================================================
local function tpTo(cf, yOffset)
    yOffset = yOffset or 5
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local target = CFrame.new(cf.Position + Vector3.new(0, yOffset, 0))
    for i = 1, 5 do
        hrp.CFrame = target
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait()
    end
end

local function getCF(obj)
    if obj:IsA("BasePart") then return obj.CFrame
    elseif obj:IsA("Model") then return obj:GetPivot() end
    return nil
end

-- Get player's plot by OwnerName attribute (Plot1-8)
local function getMyPlot()
    local plots = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Plots")
    if not plots then return nil end
    for i = 1, 8 do
        local plot = plots:FindFirstChild("Plot" .. i)
        if plot then
            local ownerName = plot:GetAttribute("OwnerName")
            if ownerName == LocalPlayer.Name then
                return plot
            end
        end
    end
    return nil
end

