Tabs.Trade:AddParagraph({ Title = "Auto Trade", Content = "Select a player then toggle." })

local tradeDropdown = Tabs.Trade:AddDropdown("TradePlayerDropdown", {
    Title       = "Players",
    Description = "Select a player to trade with",
    Values      = {},
    Default     = nil,
    Callback    = function(val)
