local function tpTo(cf, yOffset)
    yOffset = yOffset or 5
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local target = CFrame.new(cf.Position + Vector3.new(0, yOffset, 0))
    for i = 1, 5 do
        hrp.CFrame = target
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        task.wait()
    end
end

local function getCF(obj)
    if obj:IsA("BasePart") then return obj.CFrame
    elseif obj:IsA("Model") then return obj:GetPivot() end
    return nil
end

-- Fixed: Checks BasePos1 to BasePos10 and looks for lowercase "owner"
local function getMyBase()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    
    for i = 1, 10 do
        local baseName = "BasePos" .. tostring(i)
        local basePos = plots:FindFirstChild(baseName)
        
        if basePos then
            -- Check for lowercase 'owner' or uppercase 'Owner'
            local ownerVal = basePos:FindFirstChild("owner") or basePos:FindFirstChild("Owner")
            
            if ownerVal and ownerVal:IsA("StringValue") and ownerVal.Value == LocalPlayer.Name then
                
                -- If BasePos is the part itself
                if basePos:IsA("BasePart") then
                    return basePos
                end
                
                -- If the part is inside BasePos
                local basePart = basePos:FindFirstChild("Base") or basePos:FindFirstChild("BasePart")
                if basePart and basePart:IsA("BasePart") then
                    return basePart
                end
                
                -- Fallback: return the first BasePart found inside
                for _, child in ipairs(basePos:GetChildren()) do
                    if child:IsA("BasePart") then return child end
                end
                
                return basePos
            end
        end
    end
    return nil
end

