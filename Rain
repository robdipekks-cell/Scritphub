local FARM_RARITIES = {
    "Common","Rare","Epic","Legendary","Mythic",
    "Secret","Brainrot God","OG","Divine","Exclusive"
}

local autoFarm         = false
local selectedRarities = {}

Tabs.Farm:AddParagraph({ Title = "Farm", Content = "Select rarities, then toggle. TPs to matching friends and steals them." })

Tabs.Farm:AddDropdown("FarmRarityDropdown", {
    Title       = "Rarity",
    Description = "Which rarities to target",
    Values      = FARM_RARITIES,
    Multi       = true,
    Default     = {},
    Callback    = function(vals)
        selectedRarities = {}
        for k, v in pairs(vals) do
            if v then table.insert(selectedRarities, k) end
        end
    end,
})

local function raritySelected(rarity)
    for _, r in ipairs(selectedRarities) do
        if r == rarity then return true end
    end
    return false
end

local function runAutoFarm()
    while autoFarm do
        if #selectedRarities == 0 then
            task.wait(0.1)
            continue
        end

        local friends = workspace:FindFirstChild("Live") and workspace.Live:FindFirstChild("Friends")
        if not friends then task.wait(0.1) continue end

        local farmedAny = false

        for _, model in ipairs(friends:GetChildren()) do
            if not autoFarm then break end
            if not model:IsA("Model") then continue end

            local spawnRarity = model:GetAttribute("SpawnRarity")
            if not spawnRarity or not raritySelected(spawnRarity) then continue end

            local rootPart = model:FindFirstChild("RootPart")
            local prompt   = rootPart and rootPart:FindFirstChild("StealPrompt")
            local cf       = rootPart and rootPart.CFrame or getCF(model)
            
            if cf then 
                tpTo(cf, 2) 
                task.wait(0.1)
            end

            if prompt then
                pcall(fireproximityprompt, prompt)
                task.wait(prompt.HoldDuration + 0.2)
            end

            farmedAny = true

            -- TP back to base using the fixed getMyBase()
            local myBase = getMyBase()
            if myBase then
                local baseCF = getCF(myBase)
                if baseCF then 
                    tpTo(baseCF, 5) 
                end
            end

            task.wait(0.1)
        end

        if not farmedAny then task.wait(0.1) end
    end
end

Tabs.Farm:AddToggle("ToggleFarm", {
