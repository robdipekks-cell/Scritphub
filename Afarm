local function getOwnedPlot()
    local plots = workspace:FindFirstChild("Map") and workspace.Map:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plotFolder in ipairs(plots:GetChildren()) do
        local ownerSign = plotFolder:FindFirstChild("OwnerSign")
        if ownerSign and ownerSign:FindFirstChild("Face") and ownerSign.Face:FindFirstChild("SurfaceGui") then
            if ownerSign.Face.SurfaceGui.TextLabel.Text == LocalPlayer.Name then
                return plotFolder
            end
        end
    end
    return nil
end

local function isDirtOccupied(dirt)
    for _, child in ipairs(dirt:GetChildren()) do
        if child:IsA("Model") then
            return true
        end
    end
    return false
end

local function teleportToPart(part)
    local character = LocalPlayer.Character
    if not character or not part then return end
    local cf
    if part:IsA("BasePart") then
        cf = part.CFrame
    elseif part:IsA("Model") then
        cf = part:GetPivot()
    else
        local bp = part:FindFirstChildWhichIsA("BasePart")
        if bp then cf = bp.CFrame end
    end
    if cf then
        character:PivotTo(cf * CFrame.new(0, 4, 0))
        task.wait(0.15)
    end
end

