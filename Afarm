}):OnChanged(function(state) AutoPlace = state end)

task.spawn(function()
    while true do
        task.wait(1)
        if AutoPlace then
            pcall(function()
                local character = LocalPlayer.Character
                local humanoid  = character and character:FindFirstChild("Humanoid")

                if humanoid then
                    for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
                        if item:GetAttribute("Plant") then
                            humanoid:EquipTool(item)
                            task.wait(0.1)
                            break
                        end
                    end
                end

                local plot = getOwnedPlot()
                if plot then
                    local farmPlot = plot:FindFirstChild("FarmPlot")
                    if farmPlot then
                        for _, subPlot in ipairs(farmPlot:GetChildren()) do
                            local dirt = subPlot:FindFirstChild("Dirt")
                            if dirt and not isDirtOccupied(dirt) then
                                teleportToPart(dirt)
                                PlantSeed:FireServer(dirt)
                                task.wait(0.15)
                            end
                        end
                    end
                end
            end)
        end
    end
end)

