-- ── Auto Buy/Roll Loop ──────────────────────────────────────────────────────
task.spawn(function()
    while true do
        task.wait(0.1)
        if AutoBuyRoll then
            local matchFound = false

            pcall(function()
                local function checkSeedGuis(parent)
                    for _, obj in ipairs(parent:GetChildren()) do
                        if matchFound then return end
                        pcall(function()
                            local seedGui = obj:FindFirstChild("SeedGui")
                            if seedGui then
                                local rarity = seedGui.Frame.InfoFrame.Rarity.Text:gsub("%s+", "")
                                for selected, enabled in pairs(SelectedRarities) do
                                    if enabled and rarity:lower() == selected:lower() then
                                        matchFound = true
                                        -- Fire BuySeed for every amount 1 through 10
                                        for amount = 1, 6 do
                                            BuySeed:FireServer(amount)
                                            task.wait(0.05)
                                        end
                                        return
                                    end
                                end
                            else
                                checkSeedGuis(obj)
                            end
                        end)
                    end
                end
                checkSeedGuis(workspace)
            end)

            -- Only roll when no matching seed is currently showing
            if not matchFound then
                for i = 1, 10 do
                    pcall(function() RollSeeds:FireServer() end)
                    task.wait(0.05)
                end
                task.wait(0.3)
            end
        end
    end
end)

-- ── Auto Sell Crates & Auto Upgrade Plants & Auto Collect Rewards Loop ───────
task.spawn(function()
    while true do
        task.wait(1)
        local plot = getOwnedPlot()

        if AutoSellCrate and plot then
            pcall(function()
                local crates = plot:FindFirstChild("Crates")
                if crates then
                    for _, crate in ipairs(crates:GetChildren()) do
                        local prompt = crate:FindFirstChildWhichIsA("ProximityPrompt", true)
                        if prompt and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character:PivotTo(crate:GetPivot())
                            task.wait(0.2)
                            fireproximityprompt(prompt)
                            task.wait(0.2)
                        end
                    end
                    SellCrates:FireServer()
                end
            end)
        end

        if AutoUpgradePlants and plot then
            pcall(function()
                local farmPlot = plot:FindFirstChild("FarmPlot")
                if farmPlot then
                    for _, subPlot in ipairs(farmPlot:GetChildren()) do
                        local dirt = subPlot:FindFirstChild("Dirt")
                        if dirt then
                            UpgradePlant:InvokeServer(dirt)
                        end
                    end
                end
            end)
        end

        if AutoCollectRewards then
            pcall(function() ClaimPlaytimeReward:InvokeServer() end)
        end
    end
end)

