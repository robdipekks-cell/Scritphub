-- // MAIN TAB - AUTO FARM
-- ============================================================
local autoFarm          = false
local selectedRarities  = {}
local selectedMutations = {}

Tabs.Main:AddParagraph({ Title = "Auto Farm", Content = "Select rarities and mutations then enable the toggle." })

Tabs.Main:AddDropdown("RarityDropdown", {
    Title       = "Rarity",
    Description = "Which rarities to farm",
    Values      = RARITIES,
    Multi       = true,
    Default     = {},
    Callback    = function(vals)
        selectedRarities = {}
        for k, v in pairs(vals) do
            if v then table.insert(selectedRarities, k) end
        end
    end,
})

Tabs.Main:AddDropdown("MutationDropdown", {
    Title       = "Mutation",
    Description = "Which mutations to target (leave empty for any)",
    Values      = MUTATIONS,
    Multi       = true,
    Default     = {},
    Callback    = function(vals)
        selectedMutations = {}
        for k, v in pairs(vals) do
            if v then table.insert(selectedMutations, k) end
        end
    end,
})

local function mutationMatches(model)
    if #selectedMutations == 0 then return true end
    local mut = model:GetAttribute("Mutation")
    if not mut then return false end
    for _, m in ipairs(selectedMutations) do
        if mut == m then return true end
    end
    return false
end

local function runAutoFarm()
    while autoFarm do
        if #selectedRarities == 0 then
            Fluent:Notify({ Title = "Auto Farm", Content = "Select at least one Rarity!", Duration = 3 })
            task.wait(2)
            continue
        end

        local farmedAny = false

        for _, rarity in ipairs(selectedRarities) do
            if not autoFarm then break end
            local spawnPlace = workspace:FindFirstChild("SpawnPlace" .. rarity)
            if not spawnPlace then continue end

            for _, model in ipairs(spawnPlace:GetChildren()) do
                if not autoFarm then break end
                if not model:IsA("Model") then continue end
                if not mutationMatches(model) then continue end

                local cf = getCF(model)
                if cf then tpTo(cf) task.wait(0.3) end

                local prompt = model:FindFirstChild("Mesh")
                    and model.Mesh:FindFirstChild("ProximityPrompt")
                if prompt then
                    pcall(fireproximityprompt, prompt)
                    task.wait(0.5)
                end

                farmedAny = true

                local plot = getMyPlot()
                if plot then
                    local plotCF = getCF(plot)
                    if plotCF then tpTo(plotCF, 10) end
                end

                task.wait(0.3)
            end
        end

        if not farmedAny then task.wait(0.5) end
    end
end

Tabs.Main:AddToggle("ToggleAutoFarm", {
    Title       = "Auto Farm",
    Description = "TPs to matching brainrots.",
    Default     = false,
    Callback    = function(val)
        autoFarm = val
        if val then
            if #selectedRarities == 0 then
                Fluent:Notify({ Title = "Auto Farm", Content = "Select at least one Rarity first!", Duration = 4 })
                autoFarm = false
                return
            end
            task.spawn(runAutoFarm)
            Fluent:Notify({ Title = "Auto Farm", Content = "Started!", Duration = 3 })
        else
            Fluent:Notify({ Title = "Auto Farm", Content = "Stopped.", Duration = 3 })
        end
    end,
})

