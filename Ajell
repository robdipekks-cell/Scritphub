-- // COLLECT TAB
-- ============================================================
local autoCollect = false

Tabs.Collect:AddParagraph({ Title = "Auto Collect", Content = "TPs to each brainrot." })

local function runAutoCollect()
    while autoCollect do
        local plot, plotIndex = getMyPlot()
        if not plot or not plotIndex then
            Fluent:Notify({ Title = "Auto Collect", Content = "Could not find your plot!", Duration = 3 })
            task.wait(3)
            continue
        end

        for i = 1, 8 do
            if not autoCollect then break end
            local slot = plot:FindFirstChild(tostring(i))
            if not slot then continue end
            local moneyCollect = slot:FindFirstChild("MoneyCollect")
            if not moneyCollect then continue end

            local cf = getCF(moneyCollect)
            if cf then
                tpTo(cf, 0) -- 15 studs below
                task.wait(0.3)
            end
        end

        task.wait(1)
    end
end

Tabs.Collect:AddToggle("ToggleAutoCollect", {
    Title       = "Auto Collect",
    Description = "Collects money from ur plot.",
    Default     = false,
    Callback    = function(val)
        autoCollect = val
        if val then
            task.spawn(runAutoCollect)
            Fluent:Notify({ Title = "Auto Collect", Content = "Started!", Duration = 3 })
        else
            Fluent:Notify({ Title = "Auto Collect", Content = "Stopped.", Duration = 3 })
        end
    end,
})

