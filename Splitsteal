-- ─────────────────────────────────────────────
Window:SelectTab(1)

Fluent:Notify({
    Title    = "Oorbits Hub",
    Content  = "Loaded successfully! Press RightCtrl to minimise.",
    Duration = 5,
})

SaveManager:LoadAutoloadConfig()
